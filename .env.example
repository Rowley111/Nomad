# Только публичный адрес API для сборки фронтенда. Пусто = локальный режим.
# Пример адреса после отдельной публикации API: https://YOUR-API.onrender.com
VITE_API_URL=

# Только сервер. DATABASE_URL задаётся в Environment отдельного API Web Service.
# Возьмите URL существующей PostgreSQL из настроек провайдера; не коммитьте его.
DATABASE_URL=
FRONTEND_ORIGIN=https://nomad-a027.onrender.com
# Для локальной разработки дополнительно разрешите точный origin Vite,
# например FRONTEND_ORIGIN=http://localhost:5173
# Пароль первого администратора CLI запросит скрытым вводом.
# Ни пароли, ни DATABASE_URL, ни токены не помещайте в VITE_*.
